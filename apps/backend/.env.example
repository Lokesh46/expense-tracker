# ---------------------------------------------------------------------------
# Production configuration, for checking a real database locally before handing
# these same values to a hosting provider.
#
#   cp apps/backend/.env.example apps/backend/.env
#   # fill in the values below
#   npm run dev:api:prod
#
# apps/backend/.env is gitignored and must stay that way. Nothing in here
# belongs in a commit, a screenshot, or a chat window.
# ---------------------------------------------------------------------------

# A provider such as Neon shows one URL containing the credentials:
#
#   postgresql://myuser:mypassword@ep-cool-name-a1b2c3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Java needs it split into three. Add the jdbc: prefix, drop "myuser:mypassword@"
# from the URL, and keep ?sslmode=require.
DATABASE_URL=<jdbc:postgresql://YOUR-HOST/neondb?sslmode=require>
DATABASE_USERNAME=<your-db-user>
DATABASE_PASSWORD=<your-db-password>

# The exact origin allowed to call the API from a browser. A trailing slash will
# not match. Several may be given, comma-separated.
FRONTEND_URL=http://localhost:4300

# Optional. The JWT signing key as a JWK, which keeps sessions alive across
# restarts. Leave it unset locally and the file at data/jwt-signing-key.json is
# used instead; set it in production, where the filesystem does not survive a
# redeploy.
# JWT_SIGNING_KEY=

# Optional. Defaults to 8082 under --prod so it can run alongside the dev server.
# PORT=8082
